{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftframestudios.example/schemas/lims-eln-comparison-profile-1.0.0.json",
  "type": "object",
  "required": ["profile_version", "scenario_id", "required_paths", "critical_exact_paths", "ignored_paths", "numeric_tolerances", "reportable_paths", "adjudications"],
  "additionalProperties": false,
  "properties": {
    "profile_version": {"const": "1.0.0"},
    "scenario_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"},
    "required_paths": {"$ref": "#/$defs/paths"},
    "critical_exact_paths": {"$ref": "#/$defs/paths"},
    "ignored_paths": {"$ref": "#/$defs/paths"},
    "reportable_paths": {"$ref": "#/$defs/paths"},
    "numeric_tolerances": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["absolute", "relative"],
        "additionalProperties": false,
        "properties": {
          "absolute": {"type": "number", "minimum": 0},
          "relative": {"type": "number", "minimum": 0}
        }
      }
    },
    "adjudications": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["direction", "advantage_rationale", "gap_rationale"],
        "additionalProperties": false,
        "properties": {
          "direction": {"enum": ["lower_is_better", "higher_is_better"]},
          "advantage_rationale": {"type": "string", "minLength": 10},
          "gap_rationale": {"type": "string", "minLength": 10}
        }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\$\\.[A-Za-z0-9_.-]+$"}
    }
  }
}
