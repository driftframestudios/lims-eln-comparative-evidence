{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lims-eln/redacted-receipt/1.0.0",
  "title": "Redacted observed receipt manifest",
  "type": "object",
  "required": [
    "receipt_schema",
    "receipt_id",
    "receipt_family",
    "evidence_mode",
    "assurance_stage",
    "claim",
    "environment",
    "implementation_commit",
    "scenario_ids",
    "result",
    "raw_artifact_digest",
    "governed_locator",
    "limitations",
    "performed_by",
    "reviewed_by",
    "approvals",
    "classification",
    "retest_triggers"
  ],
  "properties": {
    "receipt_schema": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"},
    "receipt_family": {
      "enum": [
        "configured_vendor_environments",
        "representative_migration_restore_rehearsals",
        "production_security_observability",
        "accountable_scientific_quality_regulatory_acceptance"
      ]
    },
    "evidence_mode": {"const": "observed"},
    "assurance_stage": {"enum": ["qualified", "validated", "accepted"]},
    "claim": {"type": "string", "minLength": 1, "maxLength": 1024},
    "environment": {"type": "object", "minProperties": 1, "maxProperties": 24},
    "implementation_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"}
    },
    "result": {"type": "string", "minLength": 1, "maxLength": 256},
    "raw_artifact_digest": {"$ref": "#/$defs/sha256"},
    "governed_locator": {
      "type": "string",
      "pattern": "^(?:evidence-vault|s3)://[^/?#]+/[^?#%]+$",
      "maxLength": 512
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "performed_by": {"$ref": "#/$defs/identity"},
    "reviewed_by": {"$ref": "#/$defs/identity"},
    "approvals": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["domain", "decision", "approver"],
        "properties": {
          "domain": {"type": "string", "minLength": 1, "maxLength": 64},
          "decision": {"enum": ["accept", "revise", "escalate"]},
          "approver": {"$ref": "#/$defs/identity"}
        },
        "additionalProperties": false
      }
    },
    "classification": {
      "type": "object",
      "required": ["data_class", "redaction_status"],
      "properties": {
        "data_class": {
          "enum": [
            "approved-synthetic-exemplar",
            "approved-synthetic-qualification",
            "redacted-confidential-manifest",
            "redacted-regulated-manifest"
          ]
        },
        "redaction_status": {"const": "reviewed-redacted-manifest"}
      },
      "additionalProperties": false
    },
    "retest_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
      "minLength": 3,
      "maxLength": 128
    }
  },
  "additionalProperties": false
}
