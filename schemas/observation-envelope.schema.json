{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lims-eln/observation-envelope/1.0.0",
  "title": "Comparative observation envelope",
  "type": "object",
  "required": [
    "envelope_version",
    "observation_id",
    "evidence_mode",
    "assurance_stage",
    "scenario_id",
    "source",
    "result",
    "provenance",
    "approvals",
    "classification"
  ],
  "properties": {
    "envelope_version": {"const": "1.0.0"},
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "maxLength": 128
    },
    "evidence_mode": {"enum": ["planned", "simulated", "observed"]},
    "assurance_stage": {"enum": ["specified", "verified", "qualified", "validated", "accepted"]},
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
      "maxLength": 128
    },
    "source": {
      "type": "object",
      "required": ["environment_id", "implementation_commit", "configuration_digest"],
      "properties": {
        "environment_id": {"$ref": "#/$defs/identity"},
        "implementation_commit": {"type": "string", "minLength": 1, "maxLength": 128},
        "configuration_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "result": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["raw_artifact_digest", "governed_locator", "performed_by", "reviewed_by"],
      "properties": {
        "raw_artifact_digest": {"$ref": "#/$defs/sha256"},
        "governed_locator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*://[^?#]+$",
          "maxLength": 512
        },
        "performed_by": {"$ref": "#/$defs/identity"},
        "reviewed_by": {"$ref": "#/$defs/identity"}
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "array",
      "items": {"$ref": "#/$defs/approval"},
      "maxItems": 24
    },
    "classification": {
      "type": "object",
      "required": ["data_class", "redaction_status"],
      "properties": {
        "data_class": {
          "enum": [
            "approved-synthetic-exemplar",
            "approved-synthetic-qualification",
            "redacted-confidential-manifest",
            "redacted-regulated-manifest",
            "synthetic"
          ]
        },
        "redaction_status": {
          "enum": ["generated-identities", "reviewed-redacted-manifest"]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence_mode": {"const": "observed"}},
        "required": ["evidence_mode"]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "implementation_commit": {
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              }
            }
          },
          "provenance": {
            "properties": {
              "governed_locator": {
                "pattern": "^(?:evidence-vault|s3)://[^/?#]+/[^?#%]+$"
              }
            }
          },
          "classification": {
            "properties": {
              "redaction_status": {"const": "reviewed-redacted-manifest"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,126}[A-Za-z0-9]$",
      "minLength": 3,
      "maxLength": 128
    },
    "approval": {
      "type": "object",
      "required": ["domain", "decision", "approver"],
      "properties": {
        "domain": {
          "enum": ["engineering", "operations", "quality", "regulatory", "scientific", "security"]
        },
        "decision": {"enum": ["accept", "revise", "escalate"]},
        "approver": {"$ref": "#/$defs/identity"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
