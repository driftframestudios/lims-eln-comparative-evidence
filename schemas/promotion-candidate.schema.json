{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.driftframe.org/lims-eln-comparative-evidence/v1.0.0/promotion-candidate.schema.json",
  "title": "Comparative Evidence Promotion Candidate v1",
  "description": "Binds a comparison candidate by its derived report and source identities while a prior signed release remains independently recoverable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "promotion_receipt_id",
    "repository",
    "target_release",
    "promotion_state",
    "release_event_evidence",
    "comparison_authority",
    "candidate_coordinate",
    "prior_release_coordinate",
    "required_evidence",
    "remaining_promotion_evidence",
    "limitations",
    "accountable_role"
  ],
  "properties": {
    "$schema": {"const": "../schemas/promotion-candidate.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "promotion_receipt_id": {"const": "RCP-COMPARATIVE-PROMOTION-004"},
    "repository": {"const": "driftframestudios/lims-eln-comparative-evidence"},
    "target_release": {"const": "comparison-v0.3.2"},
    "promotion_state": {"const": "candidate_ready"},
    "release_event_evidence": {
      "const": {"evidence_mode": "planned", "assurance_stage": "specified"}
    },
    "comparison_authority": {
      "const": {
        "evidence_mode": "simulated",
        "assurance_stage": "verified",
        "comparison_mode": "simulated_verification",
        "environment_observed_closure": "separate_unasserted_state",
        "production_authorization_effect": "none"
      }
    },
    "candidate_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "repository_release",
        "constellation_lock",
        "constellation_lock_canonical_json_digest",
        "synthetic_contract_report_digest",
        "golden_specimen_report_digest",
        "golden_source_constellation_digest"
      ],
      "properties": {
        "release": {"const": "candidate-comparison-v0.3.2"},
        "repository_release": {"const": "0.3.2"},
        "constellation_lock": {"const": "constellation.lock.json"},
        "constellation_lock_canonical_json_digest": {"$ref": "#/$defs/sha256Digest"},
        "synthetic_contract_report_digest": {"$ref": "#/$defs/sha256Digest"},
        "golden_specimen_report_digest": {"$ref": "#/$defs/sha256Digest"},
        "golden_source_constellation_digest": {"$ref": "#/$defs/sha256Digest"}
      }
    },
    "prior_release_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_receipt",
        "promotion_receipt_file_sha256",
        "tag",
        "tag_object_oid",
        "commit_oid",
        "tree_oid",
        "archive_digest"
      ],
      "properties": {
        "promotion_receipt": {"const": "receipts/promotion-receipt.json"},
        "promotion_receipt_file_sha256": {"$ref": "#/$defs/sha256Digest"},
        "tag": {"const": "comparison-v0.3.1"},
        "tag_object_oid": {"$ref": "#/$defs/sha1Oid"},
        "commit_oid": {"$ref": "#/$defs/sha1Oid"},
        "tree_oid": {"$ref": "#/$defs/sha1Oid"},
        "archive_digest": {"$ref": "#/$defs/sha256Digest"}
      }
    },
    "required_evidence": {"$ref": "#/$defs/materialStatements"},
    "remaining_promotion_evidence": {"$ref": "#/$defs/materialStatements"},
    "limitations": {"$ref": "#/$defs/materialStatements"},
    "accountable_role": {"type": "string", "minLength": 3, "maxLength": 120}
  },
  "$defs": {
    "sha1Oid": {
      "type": "string",
      "pattern": "^(?!0{40}$)[a-f0-9]{40}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
    },
    "materialStatements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 20, "maxLength": 500}
    }
  }
}
